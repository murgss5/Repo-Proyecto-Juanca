header("Cache-Control: no-store, no-cache, must-revalidate, max-age=0");
header("Pragma: no-cache");
header("Expires: 0");

// Carga de rutas base y datos de demostracion
require_once dirname(__DIR__) . '/../includes/constantes.php';
?>
