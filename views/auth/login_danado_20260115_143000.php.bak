    <div class="card-body">
      <?php if (isset($_GET['error'])): ?>
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            var mensaje = '<?= htmlspecialchars($_GET['error'], ENT_QUOTES) ?>';
            var mensajeError = mensaje;
            if (mensaje === 'credenciales') {
              mensaje = 'Usuario o contrase\u00f1a incorrectos.';
            } else if (mensaje === 'El usuario no tiene un rol valido') {
              mensaje = 'No fue posible iniciar sesi\u00f3n. Contacte al administrador.';
            } else if (mensaje === 'Todos los campos son obligatorios') {
              mensaje = 'Ingrese su usuario y contrase\u00f1a para continuar.';
            }
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: mensaje,
              confirmButtonColor: '#28a745',
              confirmButtonText: 'Entendido',
              allowOutsideClick: false
            });
          });
        </script>
      <?php endif; ?>
      <!-- SweetAlert2 para validaciones -->
      <script src="<?= RUTA_BASE ?>assets/plugins/sweetalert2/sweetalert2.min.js"></script>
      <script>
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[action*="login.php"]');
        const userInput = document.getElementById('nombre_usuario');
        const passInput = document.getElementById('contrasena');
        
        if (form && userInput && passInput) {
          form.addEventListener('submit', function(e) {
            if (!userInput.value.trim() || !passInput.value) {
              e.preventDefault();
              Swal.fire({
                icon: 'warning',
                title: 'Campos incompletos',
                text: 'Ingrese su usuario y contrase\u00f1a para continuar.',
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Entendido',
                allowOutsideClick: false
              });
            }
          });
        });
      });
      </script>
      <?php endif; ?>
    </script>

